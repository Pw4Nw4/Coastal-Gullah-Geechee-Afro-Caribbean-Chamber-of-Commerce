{
  "name": "sankofa-mascot",
  "private": true,
  "version": "1.0.0",
  "description": "Animated Sankofa bird mascot for the chamber's chat assistant (React + Motion)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:embed": "tsc --noEmit && vite build --config vite.embed.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "image": "node scripts/prepare-image.mjs"
  },
  "dependencies": {
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
