# Set these in Coolify (the app's Environment Variables). Never commit real values.

# Stripe secret key. Use a TEST key (sk_test_...) until you are ready to go live.
STRIPE_SECRET_KEY=sk_test_xxx

# The public site address, used for Stripe's return links (no trailing slash)
SITE_URL=https://coastalgullahgeecheeafrocarribeanchamber.com

# Signing secret (whsec_...) of the Stripe webhook endpoint, which saves each paid membership as a `member` entry in
# /admin/submissions.csv. In Stripe (Developers > Webhooks) add the endpoint <SITE_URL>/api/stripe-webhook for the events
# checkout.session.completed and checkout.session.async_payment_succeeded. Test and live mode each have their own secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Password for downloading saved submissions at /admin/submissions.csv (any username works).
# Leave empty to turn the download off.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: each new submission is also posted here (Slack, Discord or n8n webhook URL)
FORMS_WEBHOOK_URL=

# Where submissions are saved. The Dockerfile sets /data; mount a persistent volume there.
# DATA_DIR=/data

# true while the site is only a preview: tells search engines not to index it. Remove at launch.
NOINDEX=true
